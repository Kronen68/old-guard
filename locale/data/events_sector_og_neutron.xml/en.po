#: src-en/data/events_sector_og_neutron.xml:1664
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"OG_NEUTRON_DIPLOMAT_START_WIN\"]/text"
msgstr ""
"With the stealth ship dealt with you turn you attention back to the Iron Watch transport, it's in bad shape, scans indicate that it needs some serious repairs and soon.\n"
"\n"
"The transport hails you, you're greeted by an Important looking woman wearing a suit of Iron Watch colours. \"This is Diplomat Horus, I presume you are the Federation Renegade I've been hearing about? Thank you for the help, however I have another favour to ask. I understand you are headed in the direction of the Federation Capital, Node 17, is that correct?\""

#: src-en/data/events_sector_og_neutron.xml:1668
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"OG_NEUTRON_DIPLOMAT_START_WIN\"]/choice[1]/text"
msgstr "\"We are.\""

#: src-en/data/events_sector_og_neutron.xml:1670
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"OG_NEUTRON_DIPLOMAT_START_EXPLAIN\"]/text"
msgstr ""
"\"Then I would ask that you take me onboard, I must get to the Federation "
"Base. I have a meeting with Federation Command about the rebel threat here, "
"it's of utmost importance that I make it to that meeting in time, my crew "
"tell me that my vessel is no longer in any kind of shape to make that "
"journey.\""

#: src-en/data/events_sector_og_neutron.xml:1672
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"OG_NEUTRON_DIPLOMAT_START_EXPLAIN\"]/choice[1]/text"
msgstr "Accept them onboard."

#: src-en/data/events_sector_og_neutron.xml:1674
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"OG_NEUTRON_DIPLOMAT_START_EXPLAIN\"]/choice[1]/event/text"
msgstr ""
"You dock with the transport and take onboard the diplomat, the rest of the "
"crew stay behind to get the transport to safety where it can be repaired."

#: src-en/data/events_sector_og_neutron.xml:1679
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"OG_NEUTRON_DIPLOMAT_START_EXPLAIN\"]/choice[2]/text"
msgstr "Refuse the request."

#: src-en/data/events_sector_og_neutron.xml:1681
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"OG_NEUTRON_DIPLOMAT_START_EXPLAIN\"]/choice[2]/event/text"
msgstr ""
"You politely decline, she is visibly disappointed but doesn't push the issue"
" any further."

#: src-en/data/events_sector_og_neutron.xml:1687
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"OG_NEUTRON_DIPLOMAT_START_WIN\"]/choice[2]/text"
msgstr "\"We are not, sorry.\""

#: src-en/data/events_sector_og_neutron.xml:1689
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"OG_NEUTRON_DIPLOMAT_START_WIN\"]/choice[2]/event/text"
msgstr ""
"\"That's unfortunate to hear, I fear I may not be able to make it in time "
"then, if you see any other ships heading that way could you ask them if they"
" can pick me up on the way, I'll be at the Iron Watch research base.\""

#: src-en/data/events_sector_og_neutron.xml:1691
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"OG_NEUTRON_DIPLOMAT_START_WIN\"]/choice[2]/event/choice[1]/text"
msgstr "\"Actually we are headed that way.\""

#: src-en/data/events_sector_og_neutron.xml:1695
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"OG_NEUTRON_DIPLOMAT_START_WIN\"]/choice[2]/event/choice[2]/text"
msgstr "Wish her luck."

#: src-en/data/events_sector_og_neutron.xml:1697
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"OG_NEUTRON_DIPLOMAT_START_WIN\"]/choice[2]/event/choice[2]/event/text"
msgstr ""
"With that you turn you attention to preparing your FTL drive for the next "
"jump."
