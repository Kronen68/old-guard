#: src-en/data/events_sector_og_neutron.xml:458
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"SHIP_OG_MIDNIGHT_HUNTER_MIDFIGHT_RESET\"]/text"
msgstr ""
"The enemy vessel engages it's emergency thrusters and flies directly into the pulsar, as you turn to chase the pulsar launches a mass of magnetised plasma and solar particles into your path, preventing you from following.\n"
"\n"
"Your computers calculate that based on the trajectory they were on, you have about 30 seconds before the ship will come back around to your side again."

#: src-en/data/events_sector_og_neutron.xml:467
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"SHIP_OG_MIDNIGHT_HUNTER_MIDFIGHT_RESET\"]/triggeredEvent/triggeredEventBox/tooltip"
msgstr ""
"The 'Ghost' ship will come around the pulsar and back into combat range in "
"this time!"

#: src-en/data/events_sector_og_neutron.xml:472
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"SHIP_OG_MIDNIGHT_HUNTER_MIDFIGHT_RESET\"]/choice[1]/text"
msgstr "Do something onboard the ship."

#: src-en/data/events_sector_og_neutron.xml:476
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"SHIP_OG_MIDNIGHT_HUNTER_MIDFIGHT_RESET\"]/choice[2]/text"
