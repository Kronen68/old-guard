msgid ""
"data/events_sector_og_iron.xml$//event[@name=\"OG_IRON_PROTOTYPE_OUTPOST\"]/choice[1]/event/choice[3]/event/choice[2]/text"
msgstr "Do nothing."

#: src-en/data/events_sector_og_iron.xml:1757
msgid ""
"data/events_sector_og_iron.xml$//event[@name=\"OG_IRON_PROTOTYPE_OUTPOST\"]/choice[2]/text"
msgstr "Offer a larger bribe."

#: src-en/data/events_sector_og_iron.xml:1762
msgid ""
"data/events_sector_og_iron.xml$//event[@name=\"OG_IRON_PROTOTYPE_OUTPOST\"]/choice[2]/event/text"
