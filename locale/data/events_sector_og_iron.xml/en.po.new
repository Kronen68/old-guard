#: src-en/data/events_sector_og_iron.xml:1051
msgid ""
"data/events_sector_og_iron.xml$//event[@name=\"OG_IRON_EXPLORE_TRANSPORT_FIND_LATE\"]/choice[1]/event/choice/text"
msgstr "Continue..."

#: src-en/data/events_sector_og_iron.xml:1057
msgid ""
"data/events_sector_og_iron.xml$//event[@name=\"OG_IRON_EXPLORE_TRANSPORT_FIND_LATE\"]/choice[2]/text"
msgstr "Leave them to the wreck."

#: src-en/data/events_sector_og_iron.xml:1059
