#: src-en/data/events_special_multiverse.xml.append:4
msgid ""
"data/events_special_multiverse.xml.append$//event[@name=\"SYLVAN_OG_TURRETS\"]/text"
msgstr ""
"\"Aaaaah. Ssstranger ssstranger, I might normally sssell gunssss, but I've "
"gathered quite the ssstock of turretsss lately. Maybe you could ussse one?\""

