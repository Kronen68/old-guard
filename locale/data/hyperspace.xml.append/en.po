#: src-en/data/hyperspace.xml.append:1453
msgid ""
"data/hyperspace.xml.append$//race[@name=\"human_og_dawn\"]/powerEffect/tooltip"
msgstr ""
"[COOLDOWN:30s  DURATION: 15s]\n"
"\t\t\t\tGrants the following effects:\n"
"\t\t\t\t-Avoids being targetted by crew.\n"
"\t\t\t\t-Damage increased by 50%\n"
"\t\t\t\t-Sabotage Speed increased by 25%\n"
"\t\t\t\t-Cloak duration passively regenerates\n"
"\t\t\t\t-Cloak duration reduces from the following actions:\n"
"\t\t\t\t\t-Attacking, 1x\n"
"\t\t\t\t\t-Repairing, 0.75x\n"
"\t\t\t\t\t-Moving, 0.25x"

